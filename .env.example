# User/Group ID for file permissions (run `id` in terminal to find yours)
PUID=1000
PGID=1000

# REQUIRED: Your RuneScape: DragonWilds Player ID.
# Found in-game at the bottom of the Settings Menu.
OWNER_ID=

# Server display name
SERVER_NAME=DragonWildsServer

# Name of the default world created on first startup
DEFAULT_WORLD_NAME=MyWorld

# REQUIRED: Password to access Server Management in-game
ADMIN_PASSWORD=

# Optional: Password for players to join (leave empty for public)
WORLD_PASSWORD=

# Port the server listens on (UDP)
DEFAULT_PORT=7777

# Set to false to skip updating server files on container start
UPDATE_ON_START=true

STEAM_USERNAME=
STEAM_PASSWORD=

# Cache credentials so subsequent starts don't require re-authentication
STEAM_REMEMBER_PASSWORD=true

# Display a QR code to scan with the Steam mobile app for login
STEAM_QR=true

# Prefer entering a 2FA code instead of approving in the Steam mobile app
STEAM_NO_MOBILE=false
